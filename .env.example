# Google Slides deck sync (service account with the Slides API enabled).
# Share each deck with GOOGLE_SLIDES_CLIENT_EMAIL. Either set the two fields
# below, or paste the whole service-account JSON (raw or base64) into
# GOOGLE_SLIDES_CREDENTIALS_JSON. Scope required: presentations.readonly.
GOOGLE_SLIDES_CLIENT_EMAIL=
GOOGLE_SLIDES_PRIVATE_KEY=
GOOGLE_SLIDES_CREDENTIALS_JSON=
