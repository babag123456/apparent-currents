DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/apparent_currents
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Currents — Semrush integration (server-side only; never expose to the browser)
SEMRUSH_API_KEY=

# Google admin login (required — OAuth is the only way users are created)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full callback URL on the canonical origin, e.g.
# http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CALLBACK_URL=
# Either a comma-separated email allowlist or a single Workspace domain
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
# Optional: extra origins allowed to start the OAuth flow
GOOGLE_OAUTH_ALLOWED_ORIGINS=
