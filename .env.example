DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/award_kit
PAYLOAD_SECRET=replace-with-a-long-random-secret
FIGMA_ACCESS_TOKEN=

# Optional integrations
UPLOADTHING_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
